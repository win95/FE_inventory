# Copy sang .env.local khi cần chạy local
# Địa chỉ backend FastAPI + SQLite (chạy ngoài Docker Compose, trên host).
# Frontend chỉ lấy dữ liệu nghiệp vụ qua backend này; chưa cấu hình thì
# giao diện hiện trạng thái rỗng/lỗi rõ ràng, không tự điền số.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Địa chỉ Strapi CMS (chạy trong Docker Compose, xem SETUP.md).
# Frontend lấy nội dung blog / case study / product / home qua Strapi REST.
# Chưa cấu hình thì các khối nội dung hiện trạng thái rỗng.
NEXT_PUBLIC_STRAPI_URL=http://localhost:1337
