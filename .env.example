# Copy sang .env khi cần chạy local (cả `npm run dev` lẫn `docker compose up`
# đều đọc file .env ở repo root này).
#
# --- Backend FastAPI + SQLite (chạy ngoài Docker Compose, trên host) ---
# Địa chỉ backend — CHỈ phía server dùng (route handler /api/backend/* proxy
# sang đây; trình duyệt không gọi thẳng backend nữa). Khi chạy FE trong
# Docker thì đặt http://host.docker.internal:8000 (backend ở trên host).
# Dev trên host thì để http://localhost:8000. Production: để trống thì
# proxy trả 503.
BACKEND_URL=http://localhost:8000

# Địa chỉ Strapi CMS (chạy trong Docker Compose, xem SETUP.md).
# Frontend lấy nội dung blog / case study / product / home qua Strapi REST.
# Chưa cấu hình thì các khối nội dung hiện trạng thái rỗng.
NEXT_PUBLIC_STRAPI_URL=http://localhost:1337

# Google Tag Manager (GA4 qua GTM, FE 12). Để trống = không load GTM, không
# gửi event nào. Điền GTM-XXXXXXX khi tran chốt GA4/GTM (quyết định #3).
NEXT_PUBLIC_GTM_ID=

# Domain chính của site (canonical / hreflang / sitemap / robots / JSON-LD).
# Mặc định https://awing.vn khi để trống.
NEXT_PUBLIC_SITE_URL=https://awing.vn

# Secret cho POST /api/revalidate (webhook publish Strapi → FastAPI → Next).
# Đặt giá trị ngẫu nhiên dài; để trống thì endpoint trả 503.
REVALIDATE_SECRET=doi-secret-ngau-nhien-dai

# --- Docker Compose: Strapi + Postgres (xem docker-compose.yml) ---
# Các secret dưới đây BẮT BUỘC phải có trong .env thì `docker compose up` mới
# chạy (compose báo lỗi rõ tên biến nếu thiếu). Đổi tất cả thành giá trị ngẫu
# nhiên, dài trước khi chạy thật — giá trị mẫu chỉ để thử local.
POSTGRES_DB=strapi
POSTGRES_USER=strapi
POSTGRES_PASSWORD=doi-mat-khau-manh-o-day
APP_KEYS=khoa-1,khoa-2,khoa-3,khoa-4
API_TOKEN_SALT=doi-salt
ADMIN_JWT_SECRET=doi-secret
TRANSFER_TOKEN_SALT=doi-salt
JWT_SECRET=doi-secret
ENCRYPTION_KEY=doi-khoa-ma-hoa
# Webhook Strapi → backend FastAPI trên host (để trống thì không tạo webhook).
STRAPI_WEBHOOK_URL=http://host.docker.internal:8000/api/webhooks/strapi
# Secret xác thực webhook: Strapi gửi header `Authorization: Bearer <secret>`.
# PHẢI trùng STRAPI_WEBHOOK_SECRET trong BE_inventory/.env. Sinh bằng:
# openssl rand -base64 32 — để trống thì không gửi header.
STRAPI_WEBHOOK_SECRET=
